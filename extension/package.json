{
  "name": "claude-stats",
  "displayName": "Claude Stats",
  "description": "Sidebar view of the session-stats and usage-pace Claude Code mods",
  "version": "0.8.0",
  "publisher": "caedvx",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/caedvx/claude-stats"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "claude-sidebar-secondary": [
        {
          "type": "webview",
          "id": "claudeStats.panel",
          "name": "Stats"
        }
      ]
    },
    "configuration": {
      "title": "Claude Stats",
      "properties": {
        "claudeStats.newChatLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "tab"
          ],
          "enumDescriptions": [
            "Open the handoff chat in the Claude side bar",
            "Open the handoff chat in a new editor tab"
          ],
          "default": "sidebar",
          "description": "Where \"Hand off to new chat\" opens the new chat."
        }
      }
    }
  },
  "extensionDependencies": [
    "anthropic.claude-code"
  ]
}
